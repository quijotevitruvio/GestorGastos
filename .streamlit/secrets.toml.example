# ============================================================
# Secretos para Streamlit Cloud
# ============================================================
# INSTRUCCIONES:
# 1. NO subas este archivo a GitHub (ya está en .gitignore)
# 2. En Streamlit Cloud, ve a Settings > Secrets y pega este contenido
# 3. Reemplaza los valores con tus credenciales reales

ADMIN_USER = "admin"
ADMIN_PASSWORD = "tu_contraseña_segura"
GOOGLE_SHEET_NAME = "nombre_de_tu_hoja"
GEMINI_API_KEY = "tu_api_key_de_gemini"

# Credenciales de Google (pega el contenido de credentials.json como string)
# Copia TODO el contenido de tu credentials.json y pégalo aquí:
GOOGLE_CREDENTIALS = '''
{
  "type": "service_account",
  "project_id": "tu-proyecto",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "tu-service-account@tu-proyecto.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''
